{
  "id": "./",
  "name": "FOIL",
  "short_name": "FOIL",
  "description": "Turn any picture into a collectible card and give it a rare foil finish.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#11181a",
  "background_color": "#0d1315",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "image", "accept": ["image/png", "image/apng", ".apng", "image/jpeg", "image/webp", "image/gif", "image/avif", "image/bmp"] }]
    }
  }
}
